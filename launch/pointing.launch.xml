<launch>
    <arg name="use_takeshi" default="false" />

  <group>
    <push_ros_namespace namespace="pointing" />

    <node
      pkg="hardware_tools"
      exec="pointing_node"
      name="pointing_node"
      output="screen">

        <param name="use_takeshi" value="$(var use_takeshi)" />
    </node>
  </group>

</launch>

